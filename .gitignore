# NOTE: comments must be on their own line. Git does not support trailing
# comments: "model/  # note" would be read as a filename and ignore nothing.

# Environment
.venv/
__pycache__/
*.pyc
venv/

# Secrets: never commit. Keys are loaded from here by agent/env.py.
.env
.venv
# Model weights, ~280 GB. Fetch with scripts/fetch_models.py;
# exact upstream commits are recorded in model/MANIFEST.json.
model/

# Chroma index. Rebuild with scripts/build_index.py.
db/

# Third-party papers. Not redistributed; see README for sources.
documents/

# Generated results. Runs are machine-specific and include superseded data;
# publish curated results deliberately rather than committing everything.
output/

# Scratch
*.bak
*.log

# GAIA data: GAIA asks that questions and answers not be reshared. Rebuild with
# GAIA_stack/scripts/fetch_gaia.py; only the task ids are committed. Recorded
# fixtures quote the questions and often contain the answers.
GAIA_stack/tasks/phase1-GAIA*.json
GAIA_stack/documents/
GAIA_stack/fixtures*/
